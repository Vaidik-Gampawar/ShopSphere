@model OrderDto
@{ViewData["Title"]="Order details";}
<div class="eyebrow">ORDER DETAILS</div><h1 class="mt-2">Order @Model.Id.ToString()[..8]</h1><p class="text-secondary">@Model.CreatedUtc.ToString("dd MMM yyyy, HH:mm") UTC · @Model.Status</p>
@if(Model.Status=="PendingInventory"){<div class="alert alert-info">We received your order and are confirming inventory. Refresh this page for the latest status.</div>}
@if(Model.Status=="Rejected"){<div class="alert alert-warning">This order could not be fulfilled because products or inventory were unavailable. Start a new order from the catalog.</div>}
<div class="panel my-4"><h2 class="h5">Items at time of purchase</h2><div class="table-responsive"><table class="table"><thead><tr><th>Product</th><th>Quantity</th><th>Unit price</th><th>Total</th></tr></thead><tbody>@foreach(var i in Model.Items){<tr><td>@(string.IsNullOrEmpty(i.ProductName)?$"Product {i.ProductId} (awaiting confirmation)":i.ProductName)</td><td>@i.Quantity</td><td>$@i.UnitPrice.ToString("0.00")</td><td>$@((i.UnitPrice*i.Quantity).ToString("0.00"))</td></tr>}</tbody></table></div><p class="text-end fs-4">Total $@Model.Total.ToString("0.00") USD</p></div><div class="panel"><h2 class="h5">Shipping address</h2><p class="pre-wrap">@Model.ShippingAddress</p><p class="small text-secondary">Local confirmation: @(Model.NotificationSent?"recorded in your notifications":"pending")</p><a asp-action="Details" asp-route-id="@Model.Id">Refresh status ↻</a></div>
