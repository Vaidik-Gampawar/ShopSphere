@model Page<OrderDto>
@{ViewData["Title"]="Order history";}<div class="eyebrow">YOUR PURCHASES</div><h1 class="mt-2 mb-4">Order history.</h1><partial name="_Orders" model="Model"/><nav class="d-flex gap-3 mt-3" aria-label="Order pages">@if(Model.PageNumber>1){<a asp-route-page="@(Model.PageNumber-1)">← Previous</a>}<span>Page @Model.PageNumber of @Math.Max(1,Model.TotalPages)</span>@if(Model.PageNumber<Model.TotalPages){<a asp-route-page="@(Model.PageNumber+1)">Next →</a>}</nav>
