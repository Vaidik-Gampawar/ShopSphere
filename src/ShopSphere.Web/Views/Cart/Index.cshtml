@model CartViewModel
@{ViewData["Title"]="Your cart";}
<div class="eyebrow">MAKE IT YOURS</div><h1 class="mt-2 mb-4">Your shopping cart.</h1><div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if(Model.Lines.Count==0){<div class="panel"><h2>Your cart is empty or needs attention.</h2><a asp-controller="Catalog" asp-action="Index">Explore the collection ↗</a><form asp-action="Clear" method="post" class="mt-3"><button class="btn btn-outline-dark">Clear cart</button></form></div>}else{<div class="row g-4"><div class="col-lg-7">@foreach(var line in Model.Lines){<article class="panel mb-3"><div class="d-flex justify-content-between"><h2 class="h5">@line.Product.Name</h2><strong>$@((line.Product.Price*line.Quantity).ToString("0.00"))</strong></div><p class="text-secondary">$@line.Product.Price.ToString("0.00") each · @line.Product.Stock available</p><div class="d-flex gap-3"><form asp-action="Update" method="post" class="d-flex gap-2"><input type="hidden" name="productId" value="@line.Product.Id"/><label class="visually-hidden" for="q-@line.Product.Id">Quantity for @line.Product.Name</label><input id="q-@line.Product.Id" type="number" name="quantity" value="@line.Quantity" min="1" max="99" class="form-control" style="width:85px"/><button class="btn btn-outline-dark">Update</button></form><form asp-action="Remove" method="post"><input type="hidden" name="productId" value="@line.Product.Id"/><button class="btn btn-link text-secondary">Remove</button></form></div></article>}</div><div class="col-lg-5"><div class="panel"><h2 class="h4">Order summary</h2><div class="d-flex justify-content-between border-bottom py-3 mb-3"><span>Total · USD</span><strong>$@Model.Total.ToString("0.00")</strong></div><form asp-action="Checkout" method="post"><input asp-for="Checkout.RequestId" type="hidden"/><label asp-for="Checkout.ShippingAddress" class="form-label">Shipping address</label><textarea asp-for="Checkout.ShippingAddress" class="form-control" rows="4" minlength="10" maxlength="500" required></textarea><span asp-validation-for="Checkout.ShippingAddress" class="text-danger"></span><p class="small text-secondary mt-3">Inventory and current prices are confirmed when your order is placed. This practice store collects no payment.</p><button class="btn btn-dark w-100">Place order ↗</button></form></div></div></div>}
