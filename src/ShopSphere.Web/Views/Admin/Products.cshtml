@model Page<ProductDto>
@{ViewData["Title"]="Product management";}<div class="d-flex justify-content-between align-items-center mb-4"><h1>Products.</h1><a class="btn btn-dark" asp-action="Edit">Add product ↗</a></div><div class="table-responsive"><table class="table align-middle"><thead><tr><th>Product</th><th>Price</th><th>Stock</th><th>State</th><th>Manage</th><th>Adjust inventory</th></tr></thead><tbody>@foreach(var p in Model.Items){<tr><td>@p.Name</td><td>$@p.Price</td><td>@p.Stock</td><td>@(p.IsActive?"Active":"Inactive")</td><td><a asp-action="Edit" asp-route-id="@p.Id">Edit</a><form asp-action="Deactivate" method="post" class="d-inline"><input type="hidden" name="id" value="@p.Id"/><button class="btn btn-link btn-sm">Deactivate</button></form></td><td><form asp-action="Inventory" method="post" class="d-flex gap-2"><input type="hidden" name="id" value="@p.Id"/><label class="visually-hidden" for="delta-@p.Id">Stock adjustment for @p.Name</label><input id="delta-@p.Id" type="number" name="delta" class="form-control" placeholder="+ / −" required style="width:95px"/><button class="btn btn-outline-dark btn-sm">Apply</button></form></td></tr>}</tbody></table></div><nav class="d-flex gap-3" aria-label="Admin product pages">@if(Model.PageNumber>1){<a asp-route-page="@(Model.PageNumber-1)">Previous</a>}<span>Page @Model.PageNumber of @Math.Max(1,Model.TotalPages)</span>@if(Model.PageNumber<Model.TotalPages){<a asp-route-page="@(Model.PageNumber+1)">Next</a>}</nav>
