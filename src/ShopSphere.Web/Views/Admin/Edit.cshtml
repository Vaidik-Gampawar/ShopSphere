@model EditProductViewModel
@{ViewData["Title"]="Edit product";}<h1>@(Model.Id.HasValue?"Edit product.":"New product.")</h1><form method="post" class="panel mt-4" style="max-width:760px"><div asp-validation-summary="All" class="text-danger" role="alert"></div><input asp-for="Id" type="hidden"/><label asp-for="Product.Name" class="form-label"></label><input asp-for="Product.Name" class="form-control mb-3"/><label asp-for="Product.Description" class="form-label"></label><textarea asp-for="Product.Description" class="form-control mb-3" rows="4"></textarea><label asp-for="Product.Price" class="form-label"></label><input asp-for="Product.Price" class="form-control mb-3" type="number" min="0.01" max="1000000" step="0.01"/>
@if(!Model.Id.HasValue){<label asp-for="Product.Stock" class="form-label">Initial stock</label><input asp-for="Product.Stock" class="form-control mb-3" type="number" min="0" max="1000000"/>}else{<input asp-for="Product.Stock" type="hidden"/><p class="small text-secondary">Use inventory adjustments on the products page to change stock.</p>}
<label asp-for="Product.CategoryId" class="form-label">Category</label><select asp-for="Product.CategoryId" class="form-select mb-3">@foreach(var c in Model.Categories){<option value="@c.Id">@c.Name</option>}</select><div class="form-check mb-3"><input asp-for="Product.IsActive" class="form-check-input"/><label asp-for="Product.IsActive" class="form-check-label">Active</label></div><button class="btn btn-dark">Save product</button> <a asp-action="Products" class="btn btn-link">Cancel</a></form>
