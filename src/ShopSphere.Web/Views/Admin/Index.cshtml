@model Page<OrderDto>
@{ViewData["Title"]="Administration";}<div class="eyebrow">STORE OPERATIONS</div><h1 class="mt-2">Administrator dashboard.</h1><div class="d-flex gap-3 my-4"><a class="btn btn-dark" asp-action="Products">Manage products ↗</a><a class="btn btn-outline-dark" asp-action="Categories">Manage categories</a></div><p>@Model.TotalCount total orders · Page @Model.PageNumber of @Math.Max(1,Model.TotalPages)</p><partial name="_Orders" model="Model"/>
<h2 class="h4 mt-4">Manage order status</h2>@foreach(var o in Model.Items){<form asp-action="Status" method="post" class="panel d-flex flex-wrap gap-3 align-items-center mb-2"><input type="hidden" name="id" value="@o.Id"/><span class="font-monospace">@o.Id.ToString()[..8]</span><span>@o.Status →</span><label class="visually-hidden" for="status-@o.Id">Next status</label><select id="status-@o.Id" name="status" class="form-select w-auto"><option>Processing</option><option>Shipped</option><option>Delivered</option><option>Cancelled</option></select><button class="btn btn-outline-dark">Update</button></form>}<p class="text-secondary small">Confirmed → Processing → Shipped → Delivered. Only confirmed orders can be cancelled; inventory is released before cancellation completes.</p>

<nav class="d-flex gap-3 mt-3" aria-label="Admin order pages">@if(Model.PageNumber>1){<a asp-route-page="@(Model.PageNumber-1)">← Previous</a>}@if(Model.PageNumber<Model.TotalPages){<a asp-route-page="@(Model.PageNumber+1)">Next →</a>}</nav>
