@model List<CategoryDto>
@{ViewData["Title"]="Categories";}<h1>Categories.</h1>@foreach(var c in Model){<form asp-action="SaveCategory" method="post" class="panel d-flex gap-3 my-3"><input type="hidden" name="id" value="@c.Id"/><label class="visually-hidden" for="category-@c.Id">Category name</label><input id="category-@c.Id" class="form-control" name="Name" value="@c.Name" minlength="2" maxlength="80" required/><button class="btn btn-outline-dark">Rename</button></form>}<h2 class="h4 mt-4">New category</h2><form asp-action="SaveCategory" method="post" class="panel d-flex gap-3"><label class="visually-hidden" for="new-category">New category name</label><input id="new-category" class="form-control" name="Name" minlength="2" maxlength="80" required placeholder="Category name"/><button class="btn btn-dark">Create</button></form>
