<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>@ViewData["Title"] · ShopSphere</title><link rel="stylesheet" href="~/lib/bootstrap.min.css"/><link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/></head>
<body><header class="border-bottom bg-white"><nav class="container d-flex flex-wrap align-items-center gap-4 py-3" aria-label="Main navigation"><a class="brand" asp-controller="Home" asp-action="Index"><span class="brand-icon">S</span> ShopSphere<span class="brand-dot">.</span></a><a asp-controller="Catalog" asp-action="Index">Discover</a>@if(User.Identity?.IsAuthenticated==true){<a asp-controller="Home" asp-action="Dashboard">Dashboard</a><a asp-controller="Orders" asp-action="Index">Orders</a><a asp-controller="Orders" asp-action="Notifications">Notifications</a><a asp-controller="Cart" asp-action="Index">Cart</a>@if(User.IsInRole("Administrator")){<a asp-controller="Admin" asp-action="Index">Admin</a>}<form class="ms-auto" asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-sm btn-outline-dark">Sign out</button></form>}else{<a class="ms-auto" asp-controller="Account" asp-action="Login">Sign in</a><a class="btn btn-dark" asp-controller="Account" asp-action="Register">Create account ↗</a>}</nav></header>
<main class="container py-4" id="main">@if(TempData["Success"] is string success){<div class="alert alert-success" role="status">@success</div>}@if(TempData["Error"] is string error){<div class="alert alert-danger" role="alert">@error</div>}@RenderBody()</main>
<footer class="container border-top py-4 mt-5 d-flex justify-content-between text-secondary"><span>ShopSphere · Thoughtful finds, everyday.</span><span>Practice store · No payments collected</span></footer><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>
