@model ProductDto
<article class="card product-card h-100"><a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id" class="product-art art-@(Model.CategoryId % 3)" aria-label="View @Model.Name"><span>@(Model.Category == "Technology" ? "◉" : Model.Category == "Workspace" ? "▧" : "◇")</span><small>@Model.Category</small></a><div class="card-body"><div class="d-flex justify-content-between gap-2"><h3 class="h5"><a asp-controller="Catalog" asp-action="Details" asp-route-id="@Model.Id">@Model.Name</a></h3><strong>$@Model.Price.ToString("0.00")</strong></div><p class="text-secondary small">@Model.Description</p><span class="small">@(Model.Stock>0?$"{Model.Stock} available":"Out of stock")</span></div></article>
