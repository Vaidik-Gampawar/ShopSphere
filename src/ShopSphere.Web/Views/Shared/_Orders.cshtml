@model Page<OrderDto>
@if(Model.Items.Count==0){<div class="panel">No orders yet. Your next favorite is waiting in the collection.</div>}else{<div class="table-responsive panel"><table class="table align-middle"><thead><tr><th>Order</th><th>Placed (UTC)</th><th>Status</th><th>Total</th><th></th></tr></thead><tbody>@foreach(var o in Model.Items){<tr><td class="font-monospace">@o.Id.ToString()[..8]</td><td>@o.CreatedUtc.ToString("dd MMM yyyy, HH:mm")</td><td><span class="badge text-bg-light">@o.Status</span></td><td>$@o.Total.ToString("0.00")</td><td><a asp-controller="Orders" asp-action="Details" asp-route-id="@o.Id">View →</a></td></tr>}</tbody></table></div>}
