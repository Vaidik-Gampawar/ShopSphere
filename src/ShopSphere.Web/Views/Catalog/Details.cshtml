@model ProductDto
@{ViewData["Title"]=Model.Name;}
<a asp-action="Index">← Back to collection</a><div class="row g-5 mt-2"><div class="col-md-6"><div class="product-art detail-art art-@(Model.CategoryId%3)" aria-hidden="true"><span>◇</span><small>@Model.Category</small></div></div><div class="col-md-6 py-4"><div class="eyebrow">@Model.Category</div><h1 class="mt-3">@Model.Name</h1><p class="fs-3 my-4">$@Model.Price.ToString("0.00")</p><p class="text-secondary">@Model.Description</p><p>@Model.Stock units available</p>@if(Model.Stock>0){<form asp-controller="Cart" asp-action="Add" method="post" class="mt-4"><input type="hidden" name="productId" value="@Model.Id"/><label for="quantity" class="form-label">Quantity</label><input id="quantity" class="form-control mb-3" type="number" min="1" max="@Math.Min(Model.Stock,99)" name="quantity" value="1" style="max-width:120px"/><button class="btn btn-dark btn-lg">Add to cart ↗</button></form>}else{<p class="alert alert-secondary">Currently out of stock.</p>}</div></div>
