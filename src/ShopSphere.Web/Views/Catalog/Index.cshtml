@model CatalogViewModel
@{ViewData["Title"]="Discover";}
<div class="eyebrow">THE COLLECTION</div><h1 class="mt-2">Find your everyday favorite.</h1><form class="row g-3 my-4" method="get"><div class="col-md-6"><label class="visually-hidden" for="search">Search products</label><input class="form-control" id="search" name="search" value="@Model.Search" placeholder="Search the collection…"/></div><div class="col-md-4"><label class="visually-hidden" for="categoryId">Category</label><select id="categoryId" name="categoryId" class="form-select"><option value="">All categories</option>@foreach(var c in Model.Categories){<option value="@c.Id" selected="@(c.Id==Model.CategoryId)">@c.Name</option>}</select></div><div class="col-md-2"><button class="btn btn-dark w-100">Search</button></div></form><p class="text-secondary">@Model.Products.TotalCount products</p><div class="row g-4">@foreach(var p in Model.Products.Items){<div class="col-md-4"><partial name="_ProductCard" model="p"/></div>}</div>@if(Model.Products.Items.Count==0){<div class="panel">No products found. Try another search.</div>}<nav class="d-flex gap-3 mt-4" aria-label="Product pages">@if(Model.Products.PageNumber>1){<a asp-route-page="@(Model.Products.PageNumber-1)" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId">← Previous</a>}<span>Page @Model.Products.PageNumber of @Math.Max(1,Model.Products.TotalPages)</span>@if(Model.Products.PageNumber<Model.Products.TotalPages){<a asp-route-page="@(Model.Products.PageNumber+1)" asp-route-search="@Model.Search" asp-route-categoryId="@Model.CategoryId">Next →</a>}</nav>
