@model Page<OrderDto>
@{ ViewData["Title"]="Dashboard"; }
<div class="eyebrow">YOUR SPACE</div><h1 class="mt-2 mb-3">Welcome back, @User.Identity?.Name.</h1><p class="text-secondary">Your purchases and everyday discoveries, all in one place.</p><div class="row g-3 my-4"><div class="col-md-4"><div class="panel"><div class="eyebrow">ORDERS PLACED</div><div class="display-5">@Model.TotalCount</div></div></div><div class="col-md-4"><a class="panel d-block" asp-controller="Catalog" asp-action="Index"><h3>Find something new ↗</h3><span>Explore the collection</span></a></div><div class="col-md-4"><a class="panel d-block" asp-controller="Orders" asp-action="Notifications"><h3>Your notifications ↗</h3><span>Order confirmations</span></a></div></div><h2>Recent orders</h2><partial name="_Orders" model="Model"/>
