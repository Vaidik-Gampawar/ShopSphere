@model LoginInput
@{ViewData["Title"]="Login";}
<div class="auth-panel panel mx-auto my-5"><div class="eyebrow">YOUR SHOPSPHERE</div><h1 class="my-3">Welcome back.</h1><form method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control mb-2" autocomplete="current-password"/><span asp-validation-for="Password" class="text-danger"></span><button class="btn btn-dark w-100 mt-3">Sign in</button></form><a class="d-block mt-4" asp-action="Register">New here? Create an account</a></div>
