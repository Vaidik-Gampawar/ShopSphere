@model RegisterInput
@{ViewData["Title"]="Register";}
<div class="auth-panel panel mx-auto my-5"><div class="eyebrow">YOUR SHOPSPHERE</div><h1 class="my-3">Create your account.</h1><form method="post"><div asp-validation-summary="All" class="text-danger" role="alert"></div><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control mb-3" autocomplete="name"/><span asp-validation-for="Name" class="text-danger"></span><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control mb-3" autocomplete="email"/><span asp-validation-for="Email" class="text-danger"></span><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control mb-2" autocomplete="new-password"/><span asp-validation-for="Password" class="text-danger"></span><p class="small text-secondary">Use 12–128 characters with uppercase, lowercase, a number, and a symbol.</p><button class="btn btn-dark w-100 mt-3">Create account</button></form><a class="d-block mt-4" asp-action="Login">Already a member? Sign in</a></div>
